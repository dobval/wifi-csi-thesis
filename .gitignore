# ---------------------------------------------------------------- ESP-IDF
# Build output and generated component trees (rebuilt from source)
build/
managed_components/

# Flashed/toolchain artifacts
*.bin
*.elf
*.map
*.hex
*.lst

# Per-machine project config. Contains Wi-Fi credentials and absolute paths.
# sdkconfig.defaults IS tracked — it holds the non-secret build settings.
sdkconfig
sdkconfig.old
sdkconfig.*.old
sdkconfig.local

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------- Editors / OS
.vscode/
.DS_Store
*.swp
*~

# ---------------------------------------------------------------- Publication hygiene
# Local deny-list read by .githooks/pre-commit. Contains the real SSID, so it is
# machine-local by design.
.githooks/deny.txt

# ---------------------------------------------------------------- Raw captures
# Raw CSI logs are ~150 MB per hour (960 MiB for the 6h23m soak). Never commit
# them to plain git: 58 GB of free disk is fine, a 1 GB-committing history is not.
# Every csi.csv row also carries the AP's BSSID, and the 6 h soak log contains it
# 2.3 million times. Raw captures must never be pushed to a public remote.
# Keep raw captures on disk + backup, and commit instead:
#   data/<session>/session.md      (protocol + metadata)
#   data/<session>/manifest.sha256 (integrity proof)
# To version raw data properly, install git-lfs, un-ignore the patterns below,
# and run: git lfs track "data/**/*.csv" "data/**/*.log"
data/**/*.csv
data/**/*.log
results/**/*.log

# ...but the small alignment sidecar is metadata, not raw capture: keep it so a
# session can be re-aligned to wall-clock without the 13 MB payload.
!data/**/*_clock.csv

